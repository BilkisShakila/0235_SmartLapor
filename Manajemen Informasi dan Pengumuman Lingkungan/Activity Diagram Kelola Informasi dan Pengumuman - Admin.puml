@startuml
title Activity Diagram Kelola Informasi dan Pengumuman (Admin)

|#F5F5F5|1. Admin (Petugas)|
start
:Membuka menu Kelola Pengumuman;

|#DCEBFF|2. Aplikasi Android (Smart Lapor)|
:Mengirim request GET /api/announcements;

|#EDE2F3|3. Backend REST API & Database|
:Mengambil daftar pengumuman & kirim HTTP 200;

|#DCEBFF|2. Aplikasi Android (Smart Lapor)|
:Menampilkan daftar pengumuman;

|#F5F5F5|1. Admin (Petugas)|
switch (Pilih aksi?)
case (Tambah / Ubah)
  :Mengisi atau mengubah judul & isi\npengumuman, lalu menekan Simpan;
  |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
  if (Judul & isi terisi?) then (Tidak)
    #FFB6C1:Menampilkan pesan "Judul dan isi wajib diisi";
  else (Ya)
    :Mengirim request POST / PUT /api/announcements\n(dengan Access Token JWT);
    |#EDE2F3|3. Backend REST API & Database|
    :Verifikasi JWT & peran Admin;
    :Simpan / perbarui pengumuman di Database;
    :Mengembalikan response HTTP 200 / 201;
    |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
    #90EE90:Notifikasi berhasil & segarkan daftar;
  endif
case (Hapus)
  |#F5F5F5|1. Admin (Petugas)|
  :Memilih pengumuman & menekan Hapus;
  |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
  :Menampilkan dialog konfirmasi hapus;
  |#F5F5F5|1. Admin (Petugas)|
  if (Konfirmasi?) then (Ya)
    |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
    :Mengirim request DELETE /api/announcements/{id};
    |#EDE2F3|3. Backend REST API & Database|
    :Verifikasi JWT & hapus pengumuman di Database;
    :Mengembalikan response HTTP 200 OK;
    |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
    #90EE90:Notifikasi berhasil hapus & segarkan daftar;
  else (Batal)
    |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
    :Menutup dialog konfirmasi;
  endif
case (Cari)
  |#F5F5F5|1. Admin (Petugas)|
  :Mengetik kata kunci di Search Bar;
  |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
  :Mengirim request GET /api/announcements?search={kata};
  |#EDE2F3|3. Backend REST API & Database|
  :Mencari pengumuman & kirim HTTP 200;
  |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
  :Menampilkan hasil pencarian pengumuman;
endswitch

|#F5F5F5|1. Admin (Petugas)|
stop
@enduml