@startuml
title Activity Diagram Login dan Role-Based UI (Smart Lapor)

|#F5F5F5|1. Masyarakat / Admin|
start
:Membuka halaman Login;
:Memasukkan email dan kata sandi;
:Menekan tombol Masuk;

|#DCEBFF|2. Aplikasi Android (Smart Lapor)|
:Validasi kelengkapan & format input;
if (Input valid?) then (Tidak)
  #FFB6C1:Menampilkan pesan error validasi;
  |#F5F5F5|1. Masyarakat / Admin|
  stop
else (Ya)
  |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
  :Mengirim request POST /api/auth/login;

  |#EDE2F3|3. Backend REST API & Database|
  :Memverifikasi email & kata sandi di Database;
  if (Akun valid?) then (Tidak)
    :Mengembalikan response HTTP 401 Unauthorized;
    |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
    #FFB6C1:Menampilkan pesan "Email atau sandi salah";
    |#F5F5F5|1. Masyarakat / Admin|
    stop
  else (Ya)
    |#EDE2F3|3. Backend REST API & Database|
    :Membuat Access Token & Refresh Token (JWT);
    :Mengirim token dan peran (role) ke aplikasi;

    |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
    :Menyimpan token sesi di perangkat;
    if (Peran pengguna?) then (Admin / Petugas)
      #90EE90:Menampilkan Beranda Admin;
    else (Masyarakat)
      #90EE90:Menampilkan Beranda Masyarakat;
    endif
    |#F5F5F5|1. Masyarakat / Admin|
    stop
  endif
endif
@enduml