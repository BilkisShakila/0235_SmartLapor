@startuml
title Activity Diagram Registrasi Akun Baru (Smart Lapor)

|#F5F5F5|1. User (Masyarakat)|
start
:Membuka halaman Registrasi;
:Mengisi nama, email, dan kata sandi;
:Menekan tombol Daftar;

|#DCEBFF|2. Aplikasi Android (Smart Lapor)|
:Validasi kelengkapan & format input;
if (Input valid?) then (Tidak)
  #FFB6C1:Menampilkan pesan error validasi;
  |#F5F5F5|1. User (Masyarakat)|
  stop
else (Ya)
  |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
  :Mengirim request POST /api/auth/register;

  |#EDE2F3|3. Backend REST API & Database|
  :Mengecek ketersediaan email di Database;
  if (Email sudah terdaftar?) then (Ya)
    :Mengembalikan response gagal (400);
    |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
    #FFB6C1:Menampilkan pesan "Email sudah terdaftar";
    |#F5F5F5|1. User (Masyarakat)|
    stop
  else (Belum)
    |#EDE2F3|3. Backend REST API & Database|
    :Menyimpan data akun baru ke Database;
    :Mengembalikan response berhasil (201);
    |#DCEBFF|2. Aplikasi Android (Smart Lapor)|
    #90EE90:Menampilkan notifikasi berhasil &\nMengarahkan ke halaman Login;
    |#F5F5F5|1. User (Masyarakat)|
    stop
  endif
endif
@enduml